<Project>
  <!-- Central package versions. Ask before adding a package or changing a version (see CLAUDE.md). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the security pins below override vulnerable transitive versions. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Security pins for transitive dependencies. Remove once the parent package ships a fixed version. -->
    <!-- Microsoft.Data.SqlClient 6.1.7 brings Pkcs 9.0.11: CVE-2026-84008 / CVE-2026-70162 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7), fixed in 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Hangfire.Core 1.8.25 allows Newtonsoft.Json 11.0.1: GHSA-5crp-9r3c-p9vr (high), fixed in 13.0.1. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core / EF Core 10 (all 10.0.14, published 2026-10-25) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <!-- Sign-in (M9, approved 2026-11-10): Entra ID access tokens validated by the API -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- Worker as a Windows service (M9, approved 2026-11-10) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <!-- Background jobs: Hangfire open-source (LGPL), 1.8.25 published 2026-08-28 -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="Hangfire.NetCore" Version="1.8.25" />
    <!-- PDF printing (Worker only): Playwright for .NET 1.64.1, published 2026-10-22 -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- DOCX output (Worker only; MIT): Open XML SDK, approved 2026-11-12 -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- PDF text extraction in tests only (Apache-2.0), 0.1.16 published 2026-08-22. Approved for M5. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
