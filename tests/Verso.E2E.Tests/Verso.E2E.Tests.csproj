<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Browser end-to-end tests of the 7 MVP steps (plan §8, M9): real API and Worker processes, the built SPA, Chromium
    (Playwright for .NET, the same build the Worker prints with), a throwaway LocalDB database.
    Needs Node (it builds the SPA) and Chromium (docs/setup.md, "Chromium").
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- For migrating the test database. -->
    <ProjectReference Include="..\..\src\Verso.Infrastructure\Verso.Infrastructure.csproj" />
    <!-- Built first; started as separate processes, not loaded. -->
    <ProjectReference Include="..\..\src\Verso.Api\Verso.Api.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Verso.Worker\Verso.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\**\*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
